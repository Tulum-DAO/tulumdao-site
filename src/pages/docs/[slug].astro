---
import Base from '../../layouts/Base.astro';
import DocsNav from '../../components/DocsNav.astro';
import { getCollection, render } from 'astro:content';
import lock from '../../../docs.lock.json';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  return docs.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: docs[i + 1] } }));
}
const { entry, next } = Astro.props;
const { Content } = await render(entry);
const src = `https://github.com/${lock.repo}/blob/${lock.sha}/${entry.data.source}`;
---

<Base title={`${entry.data.title} · OrchestraOS docs`} description={`${entry.data.title}: OrchestraOS documentation, built from ${entry.data.source} in the Tulum-DAO/orchestraos repository.`}>
  <div class="docs">
    <aside><DocsNav current={entry.id} /></aside>
    <article>
      <h1>{entry.data.title}</h1>
      <p class="source">
        Built from <a href={src}><code>{entry.data.source}</code></a> at <code>{lock.sha.slice(0, 7)}</code>.
      </p>
      <div class="prose"><Content /></div>
      {
        next && (
          <p class="next">
            Next: <a href={`/docs/${next.id}/`}>{next.data.title}</a>
          </p>
        )
      }
    </article>
  </div>
</Base>

<style>
  .docs {
    display: grid;
    grid-template-columns: 250px minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    padding: 32px var(--gutter) 64px;
  }
  aside {
    position: sticky;
    top: 20px;
    align-self: start;
  }
  article {
    min-width: 0;
    max-width: 78ch;
  }
  h1 {
    font-size: clamp(2rem, 4.4vw, 3.1rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
    margin: 0 0 10px;
  }
  .source {
    color: var(--doc-ink-2);
    font-size: 0.93rem;
    margin: 0 0 30px;
  }
  .source a,
  .next a {
    color: var(--doc-link);
  }
  .next {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--doc-rule);
    font-weight: 650;
  }
  .prose :global(h2) {
    font-size: 1.6rem;
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 2.2em 0 0.5em;
  }
  .prose :global(h3) {
    font-size: 1.22rem;
    margin: 1.8em 0 0.4em;
  }
  .prose :global(p),
  .prose :global(li) {
    max-width: 72ch;
  }
  .prose :global(a) {
    color: var(--doc-link);
    text-underline-offset: 3px;
  }
  .prose :global(:not(pre) > code) {
    background: var(--doc-code-bg);
    padding: 0.1em 0.35em;
    border-radius: 5px;
    overflow-wrap: anywhere;
  }
  .prose :global(pre) {
    padding: 16px 18px;
    border-radius: 12px;
    overflow-x: auto;
    font-size: 0.86rem;
    line-height: 1.6;
    border: 1px solid var(--doc-rule);
  }
  .prose :global(table) {
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    font-size: 0.94rem;
    margin: 1.2em 0;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 8px 12px;
    border-bottom: 1px solid var(--doc-rule);
    vertical-align: top;
  }
  .prose :global(blockquote) {
    margin: 1.2em 0;
    padding: 4px 18px;
    border-left: 3px solid var(--ochre);
    color: var(--doc-ink-2);
  }
  .prose :global(img) {
    height: auto;
  }
  @media (max-width: 860px) {
    .docs {
      grid-template-columns: minmax(0, 1fr);
    }
    aside {
      position: static;
      order: 2;
      border-top: 1px solid var(--doc-rule);
      padding-top: 20px;
    }
  }
</style>
