---
import { getCollection } from 'astro:content';
interface Props {
  current?: string;
}
const { current } = Astro.props;
const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
---

<nav class="docs-nav" aria-label="Documentation">
  <ul>
    {
      docs.map((d) => (
        <li>
          <a href={`/docs/${d.id}/`} aria-current={d.id === current ? 'page' : undefined}>
            {d.data.title}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .docs-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .docs-nav a {
    display: block;
    padding: 8px 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--doc-ink-2);
    font-weight: 520;
  }
  .docs-nav a:hover {
    color: var(--doc-ink);
    background: var(--doc-code-bg);
  }
  .docs-nav a[aria-current='page'] {
    color: var(--doc-ink);
    font-weight: 700;
    box-shadow: inset 3px 0 0 var(--ochre);
    background: var(--doc-code-bg);
  }
</style>
